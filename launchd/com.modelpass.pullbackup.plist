<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pull the archives down from the collection host, on this machine.

  launchd rather than cron, for one reason: StartCalendarInterval fires on
  wake if the machine was asleep at the scheduled time. cron simply skips it.
  A laptop that is shut at noon must still take the backup when it opens.

  The catch: the wake launchd fires on is usually a DarkWake -- a few seconds
  of housekeeping with no network, several times an hour, all night. The
  script keeps probing the host until the machine is properly awake, so that
  one early firing is not the day's only chance.

  Install:
    cp launchd/com.modelpass.pullbackup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.modelpass.pullbackup.plist
    launchctl start com.modelpass.pullbackup      # run once now
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.modelpass.pullbackup.plist

  Edit ProgramArguments below if the repo is not at ~/bmshowshow.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.modelpass.pullbackup</string>

  <key>ProgramArguments</key>
  <array>
    <!-- caffeinate, because waiting for the network is only half of it: the
         maintenance window that finally answered a probe expires mid-copy,
         and the transfer dies with "Connection reset by peer". -i holds off
         idle sleep for as long as the pull runs and nothing longer. -->
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/bash</string>
    <string>--login</string>
    <string>-c</string>
    <string>exec "$HOME/bmshowshow/scripts/pull_backup.sh"</string>
  </array>

  <!-- Twice a day. The collection host runs at 03:00 UTC (11:00 in Asia/
       Shanghai); the later slot catches a laptop that was shut at noon. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <!-- Direct ssh, not the Cloudflare Access tunnel. An unattended job should
       depend on as little as possible: the tunnel needs cloudflared on PATH
       and an Access token that expires, and it is slower besides. Change this
       to your own ssh host alias. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>MODELPASS_HOST</key>
    <string>lisong</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/modelpass-pull.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/modelpass-pull.err</string>

  <!-- Never let a backup pull get in the way of what the machine is doing. -->
  <key>Nice</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
