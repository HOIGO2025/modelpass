# Copy to .env (which is gitignored) and fill in.

# Contact address embedded in the User-Agent of every outbound request.
# Be reachable: it is the polite thing to do and it lowers the odds of a ban.
CONTACT_EMAIL=you@example.com

# Optional. Raises HuggingFace rate limits. Read-only token is enough.
HF_TOKEN=

# Where failure alarms go (铁律 4).
ALERT_EMAIL=you@example.com

# Off-site backup. Set at least one; both is better.
# MUST be a different provider AND a different region from the collection host.
#
# rsync-over-ssh target:
BACKUP_HOST=
# rclone remote, e.g. Cloudflare R2. Zero egress fees, and scripts/verify.sh
# restores straight out of it. Configured entirely through the environment so
# there is no rclone.conf to mount into the container:
#R2_REMOTE=r2:modelpass
#RCLONE_CONFIG_R2_TYPE=s3
#RCLONE_CONFIG_R2_PROVIDER=Cloudflare
#RCLONE_CONFIG_R2_REGION=auto
#RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#RCLONE_CONFIG_R2_ACCESS_KEY_ID=
#RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
R2_REMOTE=

# Email alerts over any SMTP relay. No MTA needed on the host, and no VPN
# needed to read them. Credentials are never sent to a relay without STARTTLS.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=<app password, not your account password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional override of the database path (default db/modelpass.db).
# Leave COMMENTED OUT, not empty: the shell scripts source this file, and an
# empty assignment would clobber a value passed in the environment.
#MODELPASS_DB=

# Docker only: the host user that owns ./data and ./db, so the container can
# write its archives. Not named UID/GID -- UID is readonly in bash and the
# shell scripts source this file.
MODELPASS_UID=1000
MODELPASS_GID=1000
